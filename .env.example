# Database Connection String (SQLAlchemy 2.0 Async Driver)
# PostgreSQL async: postgresql+asyncpg://postgres:postgres@localhost:5432/hadist_db
# SQLite async: sqlite+aiosqlite:///hadist.db
# MySQL async: mysql+aiomysql://root:password@localhost:3306/hadist_db

DATABASE_URL=sqlite+aiosqlite:///hadist.db
CONFIG_PATH=config.yaml
